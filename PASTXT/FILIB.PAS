UNIT FILIB;

INTERFACE

  USES baselib, STRLIB;

  TYPE BFILE = FILE;

  FUNCTION FILEXIST(FNAM: STRING): boolean;
  FUNCTION GETUPLES(FNAM: STRING; VAR LS: LONGSTR): BOOLEAN;
  {FUNCTION FINDTUPLE(NAM: STRING; LS: LONGSTR): STRING;}
  FUNCTION OPENTEXT(FNAM: STRING; VAR FI: TEXT; WRFL: BOOLEAN): BOOLEAN;

IMPLEMENTATION



  FUNCTION FILEXIST(FNAM: STRING): boolean;
  VAR TF: BFILE; SUCCESS: BOOLEAN; sz: longint;
  BEGIN
    ASSIGN(TF,FNAM);
    {$I-}
    RESET(Tf,1);
    {$I+}
    SUCCESS := IORESULT = 0 ;
    FILEXIST := false;
    if not success then exit;
    SZ := FILESIZE(tF);
    CLOSE(TF);
    if sz = 0 then exit;
    FILEXIST := true;
  END;

  FUNCTION OPENTEXT(FNAM: STRING; VAR FI: TEXT; WRFL: BOOLEAN): BOOLEAN;
  BEGIN
    ASSIGN(FI,FNAM);
    {$I-}
    IF WRFL
      THEN REWRITE(FI)
      ELSE  RESET(FI);
    {$I+}
    OPENTEXT := IORESULT = 0 ;
  END;

  FUNCTION GETUPLES(FNAM: STRING; VAR LS: LONGSTR): BOOLEAN;
  VAR     FTS: BFILE;    MEM: Pchar;    SZ: WORD;
  BEGIN
    GETUPLES := FALSE;
    IF not FILEXIST(FNAM) THEN EXIT;
    ASSIGN(Fts,FNAM);
    RESET(Fts,1);
    SZ := FILESIZE(FTS);
    GETMEM (MEM,SZ);
    BLOCKREAD(FTS,MEM^,SZ);
    CLOSE(FTS);
    setLstr(ls,mem,sz);
    GETUPLES := TRUE;
  END;

{  FUNCTION FINDTUPLE(NAM: STRING; LS: LONGSTR): STRING;
  VAR
    TLS: LONGSTR;
    SZ: WORD;
    TARGET, TUPLE: STRING;
    FLAG : BOOLEAN;
  BEGIN  TARGET := NAM + ',';  FINDTUPLE := '';  TLS := LS;
    REPEAT  SZ := PARS(TLS);
      IF SZ = 0  THEN EXIT;
      WITH TLS DO  TUPLE := MKSTR(ADDPTR(CP,-SZ)^ ,SZ);
    UNTIL POS(TARGET,TUPLE) = 1;
    TARGET := CUTSTR(TUPLE,',');
    FINDTUPLE := TUPLE;
  END;
}

