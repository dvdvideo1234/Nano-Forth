UNIT FILIB;

INTERFACE

  USES STRLIB;

  TYPE BFILE = FILE;

  FUNCTION FILEXIST(FNAM: STRING): byte;
  FUNCTION GETUPLES(FNAM: STRING; VAR LS: LONGSTR): BOOLEAN;
  FUNCTION FINDTUPLE(NAM: STRING; LS: LONGSTR): STRING;
  FUNCTION OPENTEXT(FNAM: STRING; VAR FI: TEXT; WRFL: BOOLEAN): BOOLEAN;

IMPLEMENTATION



  FUNCTION FILEXIST(FNAM: STRING): byte;
  VAR TF: BFILE; SUCCESS: BOOLEAN; sz: longint;
  BEGIN
    ASSIGN(TF,FNAM);
    {$I-}
    RESET(Tf,1);
    {$I+}
    SUCCESS := IORESULT = 0 ;
    FILEXIST := 0;
    if not success then exit;
    FILEXIST := 1;
    SZ := FILESIZE(tF);
    CLOSE(TF);
    if sz = 0 then exit;
    FILEXIST := 2;
  END;

  FUNCTION OPENTEXT(FNAM: STRING; VAR FI: TEXT; WRFL: BOOLEAN): BOOLEAN;
  BEGIN
    ASSIGN(FI,FNAM);
    {$I-}
    IF WRFL
      THEN REWRITE(FI)
      ELSE  RESET(FI);
    {$I+}
    OPENTEXT := IORESULT = 0 ;
  END;

  FUNCTION GETUPLES(FNAM: STRING; VAR LS: LONGSTR): BOOLEAN;
  VAR
    MEM: CPTR;
    FTS: BFILE;
    SZ: WORD;
  BEGIN
    GETUPLES := FALSE;
    IF FILEXIST(FNAM) < 2 THEN EXIT;
    ASSIGN(Fts,FNAM);
    RESET(Fts,1);
    SZ := FILESIZE(FTS);
    GETMEM (MEM,SZ);
    BLOCKREAD(FTS,MEM^,SZ);
    CLOSE(FTS);
    WITH LS DO BEGIN
      CP := MEM;
      REM := SZ;
    END;
    GETUPLES := TRUE;
  END;

  FUNCTION FINDTUPLE(NAM: STRING; LS: LONGSTR): STRING;
  VAR
    TLS: LONGSTR;
    SZ: WORD;
    TARGET, TUPLE: STRING;
    FLAG : BOOLEAN;
  BEGIN  TARGET := NAM + ',';  FINDTUPLE := '';  TLS := LS;
    REPEAT  SZ := PARS(TLS);
      IF SZ = 0  THEN EXIT;
      WITH TLS DO  TUPLE := MKSTR(ADDPTR(CP,-SZ)^ ,SZ);
    UNTIL POS(TARGET,TUPLE) = 1;
    TARGET := CUTSTR(TUPLE,',');
    FINDTUPLE := TUPLE;
  END;

BEGIN
END.