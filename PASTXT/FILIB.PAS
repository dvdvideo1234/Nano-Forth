UNIT FILIB;

INTERFACE

  USES CRT, baselib, STRLIB;

  TYPE BFILE = FILE;

  FUNCTION FILEXIST(FNAM: STRING): boolean;
  FUNCTION readbin(FNAM: STRING; VAR LS: LONGSTR): BOOLEAN;
  FUNCTION WRITEbin(FNAM: STRING; VAR TOWRITE; SIZE: WORD): BOOLEAN;
  FUNCTION OPENTEXT(FNAM: STRING; VAR FI: TEXT; WRFL: BOOLEAN): BOOLEAN;
  FUNCTION EXPECT: STRING;

IMPLEMENTATION

  FUNCTION WRITEbin(FNAM: STRING; VAR TOWRITE; SIZE: WORD): BOOLEAN;
  VAR TF: BFILE; SUCCESS: BOOLEAN; WRITTEN: WORD;
  BEGIN
    ASSIGN(TF,FNAM);
    {$I-}
    REWRITE(Tf,1);
    {$I+}
    SUCCESS := IORESULT = 0 ;
    IF SUCCESS THEN BLOCKWRITE(TF,TOWRITE,SIZE,WRITTEN);
    WRITEBIN := SUCCESS AND (SIZE = WRITTEN);
    CLOSE(TF);
  END;

  FUNCTION FILEXIST(FNAM: STRING): boolean;
  VAR TF: BFILE; SUCCESS: BOOLEAN; sz: longint;
  BEGIN
    ASSIGN(TF,FNAM);
    {$I-}
    RESET(Tf,1);
    {$I+}
    SUCCESS := IORESULT = 0 ;
    FILEXIST := false;
    if not success then exit;
    SZ := FILESIZE(tF);
    CLOSE(TF);
    if sz = 0 then exit;
    FILEXIST := true;
  END;

  FUNCTION OPENTEXT(FNAM: STRING; VAR FI: TEXT; WRFL: BOOLEAN): BOOLEAN;
  BEGIN
    ASSIGN(FI,FNAM);
    {$I-}
    IF WRFL
      THEN REWRITE(FI)
      ELSE  RESET(FI);
    {$I+}
    OPENTEXT := IORESULT = 0 ;
  END;

  FUNCTION readbin(FNAM: STRING; VAR LS: LONGSTR): BOOLEAN;
  VAR     FTS: BFILE;    MEM: Pchar;    SZ: WORD;
  BEGIN
    readbin := FALSE;
    IF not FILEXIST(FNAM) THEN EXIT;
    ASSIGN(Fts,FNAM);
    RESET(Fts,1);
    SZ := FILESIZE(FTS);
    GETMEM (MEM,SZ);
    BLOCKREAD(FTS,MEM^,SZ);
    CLOSE(FTS);
    setLstr(ls,mem,sz);
    readbin := TRUE;
  END;

  FUNCTION EXPECT: STRING;
  VAR BUFFER: ARRAY[0..127] OF CHAR;
      LEN: INTEGER; KEY: CHAR;
  BEGIN   LEN := 0;
    REPEAT KEY := READKEY;
      CASE KEY OF
       ^H: IF LEN > 0 THEN BEGIN DEC(LEN); WRITE(^H#32^H); END;
       ^@: READKEY;
       ^M: BEGIN END;
       ELSE IF (KEY >= ' ') AND (LEN < SIZEOF(BUFFER)) THEN BEGIN
         WRITE(KEY); BUFFER[LEN] := KEY; INC(LEN);
       END ELSE WRITE(^G);
      END;
    UNTIL KEY = ^M;
    EXPECT := MKSTR(BUFFER,LEN);
  END;

BEGIN
END.