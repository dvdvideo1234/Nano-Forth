UNIT FILIB;

INTERFACE

  USES STRLIB;

  FUNCTION FILEXIST(FNAM: STRING): BOOLEAN;
  FUNCTION GETUPLES(FNAM: STRING; VAR LS: LONGSTR): BOOLEAN;
  FUNCTION FINDTUPLE(NAM: STRING; LS: LONGSTR): STRING;

IMPLEMENTATION



  FUNCTION FILEXIST(FNAM: STRING): BOOLEAN;
  VAR TF: FILE; SUCCESS: BOOLEAN;
  BEGIN
    ASSIGN(TF,FNAM);
    {$I-}
    RESET(TF);
    {$I+}
    SUCCESS := IORESULT = 0 ;
    IF SUCCESS THEN CLOSE(TF);
    FILEXIST := SUCCESS;
  END;

  FUNCTION OPENFILE(FNAM: STRING; VAR FI: FILE): BOOLEAN;
  BEGIN
    ASSIGN(FI,FNAM);
    RESET(FI);
    OPENFILE := IORESULT = 0 ;
  END;

  FUNCTION GETUPLES(FNAM: STRING; VAR LS: LONGSTR): BOOLEAN;
  VAR
    MEM: CPTR;
    FTS: FILE;
    SZ: WORD;
  BEGIN
    IF NOT FILEXIST(FNAM) THEN BEGIN GETUPLES := FALSE; EXIT; END;
    OPENFILE(FNAM,FTS);
    SZ := FILESIZE(FTS);
    IF SZ = 0 THEN BEGIN CLOSE(FTS); GETUPLES := FALSE; EXIT; END;
    GETMEM (MEM,SZ);
    BLOCKREAD(FTS,MEM^,SZ);
    CLOSE(FTS);
    WITH LS DO BEGIN
      CP := MEM;
      REM := SZ;
    END;
    GETUPLES := TRUE;
  END;

  FUNCTION FINDTUPLE(NAM: STRING; LS: LONGSTR): STRING;
  VAR
    TLS: LONGSTR;
    SZ: WORD;
    TARGET, TUPLE: STRING;
    FLAG : BOOLEAN;
  BEGIN  TARGET := NAM + ',';
    TLS := LS;
    WHILE TLS.REM > 0 DO BEGIN
      SZ := PARS(TLS);
      WITH TLS DO  TUPLE := MKSTR(ADDPTR(CP,-SZ)^ ,SZ);
      IF POS(TARGET,TUPLE) = 1 THEN BEGIN {FOUND}
        TARGET := CUTSTR(TUPLE,',');
        FINDTUPLE := TUPLE;
        EXIT;
      END;
    END;
    FINDTUPLE := '';
  END;

BEGIN
END.