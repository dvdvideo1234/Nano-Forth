UNIT FILIB;

INTERFACE

  USES STRLIB;

  TYPE BFILE = FILE;

  FUNCTION FILEXIST(FNAM: STRING): BOOLEAN;
  FUNCTION GETUPLES(FNAM: STRING; VAR LS: LONGSTR): BOOLEAN;
  FUNCTION FINDTUPLE(NAM: STRING; LS: LONGSTR): STRING;
  FUNCTION OPENTEXT(FNAM: STRING; VAR FI: TEXT; WRFL: BOOLEAN): BOOLEAN;

IMPLEMENTATION



  FUNCTION FILEXIST(FNAM: STRING): BOOLEAN;
  VAR TF: BFILE; SUCCESS: BOOLEAN;
  BEGIN
    ASSIGN(TF,FNAM);
    {$I-}
    RESET(TF);
    {$I+}
    SUCCESS := IORESULT = 0 ;
    IF SUCCESS THEN CLOSE(TF);
    FILEXIST := SUCCESS;
  END;

  FUNCTION OPENFILE(FNAM: STRING; VAR FI: BFILE): BOOLEAN;
  BEGIN
    ASSIGN(FI,FNAM);
    RESET(FI,1);
    OPENFILE := IORESULT = 0 ;
  END;

  FUNCTION OPENTEXT(FNAM: STRING; VAR FI: TEXT; WRFL: BOOLEAN): BOOLEAN;
  VAR FL: BOOLEAN;
  BEGIN
    ASSIGN(FI,FNAM);
    {$I-}
    IF WRFL
      THEN REWRITE(FI)
      ELSE  RESET(FI);
    {$I+}
    OPENTEXT := IORESULT = 0 ;
  END;

  FUNCTION GETUPLES(FNAM: STRING; VAR LS: LONGSTR): BOOLEAN;
  VAR
    MEM: CPTR;
    FTS: BFILE;
    SZ: WORD;
  BEGIN
    GETUPLES := FALSE;
    IF NOT FILEXIST(FNAM) THEN EXIT;
    IF NOT OPENFILE(FNAM,FTS) THEN EXIT;
    SZ := FILESIZE(FTS);
    IF SZ = 0 THEN BEGIN CLOSE(FTS); EXIT; END;
    GETMEM (MEM,SZ);
    BLOCKREAD(FTS,MEM^,SZ);
    CLOSE(FTS);
    WITH LS DO BEGIN
      CP := MEM;
      REM := SZ;
    END;
    GETUPLES := TRUE;
  END;

  FUNCTION FINDTUPLE(NAM: STRING; LS: LONGSTR): STRING;
  VAR
    TLS: LONGSTR;
    SZ: WORD;
    TARGET, TUPLE: STRING;
    FLAG : BOOLEAN;
  BEGIN  TARGET := NAM + ',';  FINDTUPLE := '';  TLS := LS;
    REPEAT  SZ := PARS(TLS);
      IF SZ = 0  THEN EXIT;
      WITH TLS DO  TUPLE := MKSTR(ADDPTR(CP,-SZ)^ ,SZ);
    UNTIL POS(TARGET,TUPLE) = 1;
    TARGET := CUTSTR(TUPLE,',');
    FINDTUPLE := TUPLE;
  END;

BEGIN
END.