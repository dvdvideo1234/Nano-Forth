: ;, EX , ;
: ;SWAP EX SWAP ;
: ;DROP EX DROP ;
: TO` ;, : 'TO ' 2- ;
: AT` ;, : 'AT 'TO 2- ;
: \` 0 TO LTIB ;
' \` =: \			\ WE HAVE COMMENTS ALREADY
: TO 'TO EXEC ;		\ EXECUTE OTHER 
: AT 'AT EXEC ;		\	METHODS OF VARIABLES

: LIKE ' @ ;
: CODE,  ;,
: H=: H =: ;
: C, |H 
: C!+ PUSH C!R+ POP ;
LIKE U< CODE, NIP $C3 C,
: ;NIP EX NIP ;


\ CONSTANTS

32 LIKE 1L CODE, BL ,
0  LIKE 1L CODE, 0 ,
' LIT, @ 1+ STR + 		\ ADR DOES
LIKE 1L CODE, @DOES ,	\ CONSTANT @DOES


\ BASE OPERATIONS

: I J ;				\ TOP OF THE RETURN STACK
: TWICE I 			\ EXECUTE CODE AFTER TWICE
: EXECUTE PUSH ;
: XEP| XR EXECUTE POP ;
: (& @R+ RDROP
: AND NAND 
: NOT DUP NAND ; 
: DNOT NOT PUSH NOT POP ;
: = XOR 0= ;
: OR  DNOT NAND ; 
: ?MSB DUP
: MSB& (& ,< $8000 , 
: (2OP 2DUP XOR MSB& XEP| 
: 2ABS TWICE SWAP
: ABS ?MSB 0;
: NEG 1- NOT ;
: - NEG
: + +2/ DROP; ;		H 2-  TO H	\ BACK 2 BYTES
: -ALLOT NEG
: ALLOT |H + ;
: MARK>` H
: Z, 0 , ;
: A@ XA I XA ;
: 0A! 0
: A! PUSH XA
: EXIT rdrop ;


\ BASE STRING OPERATION

: TIMES PUSH XR
: TIMES| (FOR MARK> BEGIN PUSH J EXECUTE 
	CSWAP THEN POP (IF- <RELEASE
: .EXIT POP
: 2DROP  NAND DROP; ; 2 -ALLOT


\ STRINGS OUTPUT

: (". ("+ 
: ". CSTR 
: TYPE ;DROP TIMES| CSTR EMIT ;
: ;SPC EX
: SPC BL EMIT ;
: CR (". ,< 2 C, 13 C, 10 C, >, 0 TO CNTC ;
: ID. ;SPC ". ;
: `OK SPC (". ,< TOK, Ok >, CR 
	(". ,< TOK, => >, ;
' `OK '  OK 2+ !  \ FIX OK

: `ERR CR TBUF ID. ERRA ID. CR ;
' `ERR ' ERRV 2+ !


\ STRINGS COMPILE

: TOK, TOKEN?
: ", CSTR STR1+ ;DROP TIMES| CSTR C, ;
: (", ("+ ", ;


\ VARIABLE CREATORS

: VARIABLE 0
: VAR ;,
: CREATE H=:  COMPILE ,< 'AT KEY @ 2+ , >, ;

: QUAN COMPILE ,< 'AT KEY @, >, 
: VALUE COMPILE ,< 'TO H @, >, 
: CONST ;, H=: COMPILE ,< ' H @, >, ;

: VQUAN COMPILE ,< 'AT KEY @, >, 
: VECTOR COMPILE ,< 'TO H @, >, 
: DEFER ;, H=: COMPILE ,< ' KEY @, >, ;


\ CONTROL STRUCTURES DEFINITIONS

: WHILE`
: IF` COMPILE (IF MARK>` ;
: IF-` COMPILE (IF- MARK>` ;
: UNTIL` COMPILE (IF <RELEASE` ;
: UNTIL-` COMPILE (IF- <RELEASE` ;
: ENDOF`
: ELSE` ;THEN ;SWAP
: AHEAD` COMPILE (BR MARK` ;
: REPEAT` SWAP ;THEN
: AGAIN` COMPILE (BR <RELEASE` ;
: (OF OVER = IF @R+ 2DROP (;  		\ SKIP ADDRES, DROP TARGET 
      THEN @R+ XR DROP; ; 2 -ALLOT	\ JUMP TO ADDRESS
: OF`  COMPILE (OF MARK>` ;
: CASE` 0 ;
: ENDCASE` COMPILE DROP 
	BEGIN DUP WHILE 

\ METHODZ

: DOES>` H T @ ! @DOES	\ INWORD DOES 
: CALL, $E8 C,
: REL, 2+ H - , ;	\ COMPILE  RELATIVE ADDRESS

: METODZ CREATE NEG , DOES>		\ CREATOR OF THE METHODS
  @ @DOES + H SWAP CALL, ;		\ ALONE DOES
 
0 METODZ DZ0> 		\ FIRST METHOD
1 METODZ DZ1> 		\ SECOND METHOD  ( TO )
2 METODZ DZ2> 		\ THIRD METHOD	 ( AT )


\ MATH

: D1- PUSH DUP IF 1- POP (; THEN 1- POP 1- ;
: FIX  @R+
: STA  @R+ ! ;
: LDA  @R+ @ ;

: 2DUP TWICE
: OVER PUSH DUP XR POP ;
: -ROT SWAP
: USWAP PUSH SWAP POP ;
: ROT USWAP SWAP ;

 
