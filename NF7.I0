locals  @@

pd  equ dword ptr
pw  equ word  ptr
pb  equ byte  ptr

TO_     =  -2
AT_     =  -4
VL_     =  2

JMPS    MACRO LBL
          jmp  SHORT LBL
        ENDM

SKIPA   MACRO
        DB    03DH
        ENDM

SKIPB   MACRO
        DB    03CH
        ENDM

SKIPr   MACRO reg
        mov   reg,0
        org   $-2
        ENDM


X       MACRO
  xchg Rsp,DSP
        ENDM

TO_R    MACRO  REG
  PUSH   REG
        ENDM

R_TO    MACRO  REG
  POP    REG
        ENDM

TO_D    MACRO  REG
  X
  PUSH   REG
  X
        ENDM

D_TO    MACRO  REG
  X
  POP    REG
  X
        ENDM

tDUP    macro
        CALL  @_TOPDUP
        endm

TDROP   macro
        CALL  @_TOPDROP
        endm

w2      macro
  scasw
        endm

wip2    macro
  cmpsw
endm

cf_to   macro  reg
  sbb   reg,reg
  endm

rchg    macro   reg
  xchg  ax,reg
  endm

DUP2    MACRO   R1,R2
  X
  PUSH  R1
  PUSH  R2
  X
  ENDM

DROP2   MACRO   R1,R2
  X
  POP   R1
  POP   R2
  X
        ENDM

qqqqq = 0
ppppp = qqqqq

nam    macro   msg
  local endstr
  db    endstr-$-1
  db    msg
endstr  label   byte
        endm

ln     macro   token
ppppp = $
  nam  token
  dw    qqqqq
qqqqq = ppppp
        endm

ALGN  MACRO  FLAG
        IF ($-START+FLAG) AND 1
        NOP
        ENDIF
        ENDM

;        _ALGN 0
;HLBL    =      ($-START+100H) SHR 1
XALGN MACRO  HLBL
HLBL:
        ENDM

;;LBL     =      (($-START+100H) SHR 1)+08000H
;colGO  macro  lbl,LBL2
;        COL2 LBL
;        LBL  LBL2
;        endm

XT     macro   LBL,ADR
LBL		DW ADR
        ENDM

col3   macro  lbl
        XT LBL,@NEST3
        endm

col2   macro  lbl
        XT LBL,@NEST2
        endm

col    macro  lbl
        XT LBL,@NEST
        endm

RVAR3  macro  lbl
        XT LBL,@PUSHW3
        endm

RVAR2  macro  lbl
        XT LBL,@PUSHW2
        endm

RVAR   macro  lbl
        XT LBL,@PUSHW
        endm

LBL    macro  lbl
        XT LBL,@LBL
        endm

VAR    macro   LBL
        XT LBL.@_VAR
        ENDM

PRIM   macro  lbl
        xt  lbl,$+2
        endm

CNST  macro   lbl,dat
        XT LBL,@_cons
        DW    DAT
        endm

value  macro   lbl,dat
        DW     @_setvar2
		CNST   lbl,dat
        endm

QUAN   MACRO   LBL,DAT
        DW     @_VAR3
		value lbl,dat
        ENDM

DEFERO macro   lbl,dat
        XT LBL,@_deferO
        DW     dat
        endm

DEFER  macro   lbl,dat
        XT LBL,@_DEFER
        DW dat
        endm

vector macro   lbl,dat
        DW     @_setvar2
		defer lbl,dat
        endm

point  macro   lbl,dat
        DW @_setpnt
        XT LBL,@_point
		dw dat
        endm

;VOC    MACRO   LBL,DAT
;        XALGN lbl
;        DW     @_SET_VOC,@_SRCH_VOC,dat
;        ENDM

;MCONS  macro   lbl,dat
;        XALGN LBL
;        DW    DOCNST-1
;        DW    _DOES5
;        DW    DAT
;        endm

entry  macro nam1,ADR
        DW    ADR,0
        nam  nam1
        endm

